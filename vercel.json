{
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/personvern", "destination": "/personvern.html" },
    { "source": "/bekreft", "destination": "/bekreft.html" },
    { "source": "/avmelding", "destination": "/avmelding.html" },
    { "source": "/statsbudsjett", "destination": "/index.html" },
    { "source": "/statsbudsjett/", "destination": "/index.html" },
    { "source": "/ordliste", "destination": "/index.html" },
    { "source": "/app/ordliste", "destination": "/index.html" },
    { "source": "/design", "destination": "/index.html" },
    { "source": "/app/design", "destination": "/index.html" },
    { "source": "/min-side", "destination": "/index.html" },
    { "source": "/app/min-side", "destination": "/index.html" },
    { "source": "/mobiliser", "destination": "/index.html" },
    { "source": "/mobiliser/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/404.html", "statusCode": 404 }
  ],
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live; style-src 'self' https://fonts.googleapis.com https://vercel.live; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://vercel.live https://vercel.com; connect-src 'self' https://zyyijlvmgoanjdzngmon.supabase.co wss://zyyijlvmgoanjdzngmon.supabase.co https://vercel.live https://*.pusher.com wss://*.pusher.com; frame-src https://vercel.live; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
