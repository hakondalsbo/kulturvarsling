# Kommuneportalen er en mock og vises ikke før dette settes til true.
VITE_KOMMUNELOGIN=false

# Betalingsmur. Utelatt eller annet enn true: åpen prøvedrift, ingen priser.
# Sett bare true når Stripe-premium skal vises igjen.
# VITE_PREMIUM_AKTIV=true

# Høringshjelp er av. Ikke sett denne til true før den skal åpnes.
# VITE_HORINGSHJELP=true

# Serverhemmeligheter (Supabase, ikke Vite). La dem stå av i prøvedrift:
# PREMIUM_AKTIV=true skrur budsjett-sperren og stripe-checkout på igjen.
# ADMIN_EPOSTER=fornavn@domene.no gir tilgang til /admin/tilbakemeldinger.
# HORINGSHJELP_AKTIV, UTSENDING_AKTIV og MOBILISERING_SIGNATUR_AKTIV skal ikke settes til true her.

# Cloudflare Turnstile (site key). Tom eller utelatt: innlogging og signering
# virker som før. Hemmeligheten ligger i Supabase, ikke her.
# VITE_TURNSTILE_SITE_KEY=
